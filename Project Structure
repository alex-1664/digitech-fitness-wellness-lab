digitech-fitness-system/
│
├── server.js                       # Main Express server
├── package.json                     # Node.js dependencies & start script
├── package-lock.json
├── .env                             # Environment variables (API keys, ports)
│
├── public/                          # Frontend (HTML, CSS, JS)
│   ├── login.html                   # Admin login page
│   ├── dashboard.html               # Admin dashboard (charts, AI panel placeholder)
│   ├── members.html                 # Members list page
│   ├── payments.html                # M-PESA payments page
│   ├── attendance.html              # Attendance overview page
│   ├── scan.html                    # QR check-in scanner page
│   ├── member-card.html             # Printable membership card page
│   ├── progress.html                # Gym progress tracker placeholder
│   ├── qrcodes/                     # Generated member QR codes
│   └── assets/
│       ├── styles/
│       │   └── style.css            # CSS styling
│       └── scripts/                 # Optional frontend JS
│
├── routes/                          # Express route handlers
│   ├── authRoutes.js                # Admin login/logout
│   ├── memberRoutes.js              # Member registration/listing
│   ├── paymentRoutes.js             # M-PESA payment workflow + receipts
│   ├── attendanceRoutes.js          # QR check-in + attendance recording
│   └── progressRoutes.js            # Gym progress tracking
│
├── utils/                           # Helper functions
│   ├── generateQR.js                # Generates QR code images
│   ├── sms.js                       # Sends SMS reminders
│   ├── renewalReminder.js           # Membership expiry reminder logic
│   ├── checkMembershipExpiry.js     # Cron job daily check
│   └── reports.js                   # Revenue & performance reports
│
├── data/                            # JSON data storage (can later use DB)
│   ├── members.json                 # Members info + QR + expiry
│   ├── attendance.json              # Attendance records
│   └── payments.json                # Payment records + receipts
│
├── receipts/                        # Generated PDF receipts
│   └── receipt-<timestamp>.pdf
│
└── logs/
    └── organize-log.txt             # File organization logs
